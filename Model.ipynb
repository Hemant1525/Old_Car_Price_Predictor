# In[116]:


import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# In[117]:


df = pd.read_csv("/Users/hemantjain/Old_Car_Price_Prediction_Model/car_price.csv")

# In[118]:


df.head()

# In[119]:


df.drop(['car_prices_in_rupee'], axis=1, inplace=True)

# In[120]:


df.head()

# In[121]:


df.info()

# # LABLE ENCODING

# In[122]:


from sklearn.preprocessing import LabelEncoder

# # CAR_NAME

# In[123]:


car_name_le = LabelEncoder()
df['car_name'] = car_name_le.fit_transform(df['car_name'])

# # FUEL_TYPE

# In[124]:


fuel_type_le = LabelEncoder()
df['fuel_type'] = fuel_type_le.fit_transform(df['fuel_type'])

# # TRANSMISSION

# In[125]:


Transmission_le = LabelEncoder()
df['Transmission'] = Transmission_le.fit_transform(df['Transmission'])

# In[126]:


df.head()

# In[127]:


df.isnull().sum()

# In[128]:


df.describe()

# In[129]:


df.info()

# In[130]:


x = df.iloc[:,:-1]
y = df['Price_in_rupees']

# In[131]:


x

# In[132]:


y

# # SCALLING

# In[133]:


from sklearn.preprocessing import StandardScaler

# In[134]:


ss = StandardScaler()
x = pd.DataFrame(ss.fit_transform(x), columns=x.columns)

# In[135]:


x

# In[136]:


import matplotlib.pyplot as plt
import seaborn as sns
sns.set_style("whitegrid")

# In[137]:


# Price distribution
plt.figure(figsize=(8,5))
sns.histplot(df['Price_in_rupees'], bins=50, kde=True)
plt.title("Car Price Distribution")
plt.xlabel("Price (₹)")
plt.show()

# In[138]:


# Fuel type vs Price
plt.figure(figsize=(8,5))
sns.boxplot(data=df, x='fuel_type', y='Price_in_rupees')
plt.title("Price by Fuel Type")
plt.xticks(rotation=30)
plt.show()

# In[139]:


# Manufacture year vs Price
plt.figure(figsize=(9,5))
sns.scatterplot(data=df, x='Manufacture', y='Price_in_rupees', alpha=0.4)
plt.title("Price vs Manufacture Year")
plt.show()

# In[140]:


# Kms driven vs Price
plt.figure(figsize=(9,5))
sns.scatterplot(data=df, x='Kms_driven', y='Price_in_rupees', alpha=0.4)
plt.title("Price vs Kms Driven")
plt.show()

# In[141]:


# Transmission vs Price
plt.figure(figsize=(6,5))
sns.boxplot(data=df, x='Transmission', y='Price_in_rupees')
plt.title("Price by Transmission")
plt.show()

# In[142]:


# Correlation heatmap (sirf numeric columns)
plt.figure(figsize=(7,6))
numeric_cols = df[['Kms_driven','Ownership','Manufacture','Engine_cc','Seats','Price_in_rupees']]
sns.heatmap(numeric_cols.corr(), annot=True, cmap="coolwarm", fmt=".2f")
plt.title("Correlation Heatmap")
plt.show()

# # TRAIN_TEST_SPLIT

# In[143]:


from sklearn.model_selection import train_test_split

# In[144]:


x_train,x_test,y_train,y_test = train_test_split(x,y,test_size=0.2,random_state=42)

# In[145]:


from sklearn.linear_model import LinearRegression
from sklearn.tree import DecisionTreeRegressor
from sklearn.svm import SVR
from sklearn.neighbors import KNeighborsRegressor
from sklearn.ensemble import RandomForestRegressor

# In[146]:


from sklearn.metrics import mean_squared_error,mean_absolute_error

# In[147]:


lr = LinearRegression()
lr.fit(x_train,y_train)
lr.score(x_train,y_train)*100,lr.score(x_test,y_test)*100

# In[148]:


mean_squared_error(y_test,lr.predict(x_test)),mean_absolute_error(y_test,lr.predict(x_test))

# In[149]:


dt = DecisionTreeRegressor()
dt.fit(x_train,y_train)
dt.score(x_train,y_train)*100,dt.score(x_test,y_test)*100

# In[150]:


mean_squared_error(y_test,dt.predict(x_test)),mean_absolute_error(y_test,dt.predict(x_test))

# In[151]:


rf = RandomForestRegressor(n_estimators=100)
rf.fit(x_train,y_train)
rf.score(x_train,y_train)*100,rf.score(x_test,y_test)*100

# In[152]:


mean_squared_error(y_test,rf.predict(x_test)),mean_absolute_error(y_test,rf.predict(x_test))

# In[153]:


# Actual vs Predicted scatter — sabse important graph model ke liye
y_pred = rf.predict(x_test)

plt.figure(figsize=(7,7))
plt.scatter(y_test, y_pred, alpha=0.4)
plt.plot([y_test.min(), y_test.max()], [y_test.min(), y_test.max()], 'r--', lw=2)
plt.xlabel("Actual Price (₹)")
plt.ylabel("Predicted Price (₹)")
plt.title("Actual vs Predicted Price")
plt.show()

# In[154]:


# Residual plot — errors kahan zyada hain, ye dikhata hai
residuals = y_test - y_pred

plt.figure(figsize=(8,5))
sns.scatterplot(x=y_pred, y=residuals, alpha=0.4)
plt.axhline(0, color='red', linestyle='--')
plt.xlabel("Predicted Price (₹)")
plt.ylabel("Residual (Actual - Predicted)")
plt.title("Residual Plot")
plt.show()

# In[155]:


# Feature importance — kaunsa feature sabse zyada matter karta hai
importance_df = pd.DataFrame({
    'feature': x.columns,
    'importance': rf.feature_importances_
}).sort_values('importance', ascending=False)

plt.figure(figsize=(8,5))
sns.barplot(data=importance_df, x='importance', y='feature')
plt.title("Feature Importance (Random Forest)")
plt.show()

# In[156]:


# Model comparison — lr, dt, rf teeno ka R2 side by side
model_scores = pd.DataFrame({
    'Model': ['Linear Regression', 'Decision Tree', 'Random Forest'],
    'Train R2': [lr.score(x_train,y_train)*100, dt.score(x_train,y_train)*100, rf.score(x_train,y_train)*100],
    'Test R2':  [lr.score(x_test,y_test)*100, dt.score(x_test,y_test)*100, rf.score(x_test,y_test)*100]
})

model_scores.set_index('Model').plot(kind='bar', figsize=(8,5))
plt.title("Model Comparison (Train vs Test R2)")
plt.ylabel("R2 Score (%)")
plt.xticks(rotation=0)
plt.show()

